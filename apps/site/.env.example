# apps/site environment template.
# Copy to .env.local and override as needed; all fields fall back to the
# canonical upstream values if unset.

# Public site URL — used in OpenGraph metadata and canonical links.
NEXT_PUBLIC_SITE_URL=https://px402.allensaji.dev

# Demo API base — the public px402 demo server that the marketing site
# points its curl examples at.
NEXT_PUBLIC_DEMO_API_BASE=https://api.px402.allensaji.dev

# Creator credit — override these in a fork that re-attributes the site.
NEXT_PUBLIC_AUTHOR_NAME=Allen Saji
NEXT_PUBLIC_AUTHOR_URL=https://allensaji.dev
NEXT_PUBLIC_TWITTER_HANDLE=@SajiBhai011
NEXT_PUBLIC_TWITTER_URL=https://x.com/SajiBhai011
