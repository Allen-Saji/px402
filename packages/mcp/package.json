{
  "name": "@px402/mcp",
  "version": "0.1.0-rc.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server that lets Claude pay for APIs via px402",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "solana",
    "x402",
    "magicblock",
    "agents",
    "payments"
  ],
  "license": "Apache-2.0",
  "author": "Allen Saji <allensaji04@gmail.com>",
  "homepage": "https://github.com/Allen-Saji/px402#readme",
  "bugs": {
    "url": "https://github.com/Allen-Saji/px402/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allen-Saji/px402.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "px402-mcp": "./bin/px402-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@px402/client": "workspace:*",
    "@solana/web3.js": "^1.95.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
