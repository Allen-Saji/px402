{
  "name": "@px402/core",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "px402 core: HMAC payment tokens, clientRefId-based verification, rate limiting, base-chain polling subscriber",
  "keywords": [
    "solana",
    "x402",
    "magicblock",
    "agents",
    "payments",
    "privacy",
    "usdc"
  ],
  "license": "Apache-2.0",
  "author": "Allen Saji <allensaji04@gmail.com>",
  "homepage": "https://github.com/Allen-Saji/px402#readme",
  "bugs": {
    "url": "https://github.com/Allen-Saji/px402/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allen-Saji/px402.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
